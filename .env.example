# ---------------------------------------------------------------------------
# Institution identity. Every string a student sees comes from here, so the
# same deployment serves Juba, Upper Nile, Bahr el Ghazal or Rumbek by config.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_INSTITUTION_NAME="University of Juba"
NEXT_PUBLIC_INSTITUTION_SHORT="UoJ"
NEXT_PUBLIC_INSTITUTION_CITY="Juba, Central Equatoria"
NEXT_PUBLIC_ACADEMIC_YEAR="2026/2027"

# ---------------------------------------------------------------------------
# Application fee, in SSP. Charged once per submitted application.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPLICATION_FEE_SSP="15000"

# ---------------------------------------------------------------------------
# Mobile money. Leave the keys blank in development — the mock payment
# provider in src/lib/data/payments.ts is used whenever they are unset.
# ---------------------------------------------------------------------------
MGURUSH_MERCHANT_ID=
MGURUSH_API_KEY=
NILEPAY_MERCHANT_ID=
NILEPAY_API_KEY=

# ---------------------------------------------------------------------------
# Database. Unset in development: the app falls back to the in-memory
# repository in src/lib/data/. See README "Swapping in Postgres".
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Session signing. Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET="dev-only-insecure-secret-replace-me"
