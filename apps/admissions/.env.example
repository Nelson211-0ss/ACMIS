# Copy to .env.local. See the root README for the full list.
ACMIS_API_URL=http://localhost:8000
ACMIS_API_INTERNAL_URL=http://localhost:8000
# openssl rand -base64 32
ACMIS_SESSION_SECRET=dev-only-secret-at-least-32-bytes-long!!
