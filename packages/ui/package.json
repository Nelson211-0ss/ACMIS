    "react": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "next": "^15.1.6",
    "react-dom": "^19.0.0",
    "@types/node": "^22.10.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.1.6"
