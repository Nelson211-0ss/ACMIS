{
  "name": "acmis",
  "private": true,
  "version": "1.0.0",
  "description": "ACMIS — multi-tenant Academic Management Information System for universities",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "api": "pnpm --filter @acmis/api-dev run dev",
    "sdk:generate": "pnpm --filter @acmis/api-client run generate"
  },
  "devDependencies": {
    "@acmis/eslint-config": "workspace:*",
    "@acmis/typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  }
}
